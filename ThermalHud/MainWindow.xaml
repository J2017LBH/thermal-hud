<Window x:Class="ThermalHud.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ThermalHud"
        Title="{x:Static local:MainWindow.WindowTitle}" Icon="ThermalHud.ico"
        Width="388" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="Manual"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="StartMonitoring" Closed="StopMonitoring">
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <StackPanel>
            <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush}">
                <Grid Margin="13,9,9,9" MinHeight="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Background="Transparent"
                                MouseLeftButtonDown="DragHeader" ToolTip="拖动以移动窗口">
                        <Border Width="34" Height="34" CornerRadius="8" VerticalAlignment="Center"
                                Background="#102A35" BorderBrush="#27616E" BorderThickness="1">
                            <Path Data="M 0,10 L 5,10 8,4 12,16 15,10 20,10"
                                  Stroke="{StaticResource CpuBrush}" StrokeThickness="1.6"
                                  StrokeLineJoin="Round" HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="THERMAL HUD" FontSize="16" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Ellipse Width="5" Height="5" Margin="0,0,5,0"
                                         Fill="{StaticResource CpuBrush}"/>
                                <TextBlock x:Name="WindowMode" Text="只读硬件监控 · 置顶" FontSize="10"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="SettingsButton" Grid.Column="1" Style="{StaticResource QuietButton}"
                            Width="39" Height="34" Margin="0,0,4,0" Padding="0"
                            Click="ToggleSettings" ToolTip="监控设置"
                            AutomationProperties.Name="监控设置">
                        <Path Data="M 1,4 L 17,4 M 1,10 L 17,10 M 1,16 L 17,16
                                    M 6,1 L 6,7 M 12,7 L 12,13 M 7,13 L 7,19"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource QuietButton}"
                            Width="34" Height="34" Padding="0" Click="CloseWindow" ToolTip="关闭"
                            AutomationProperties.Name="关闭监控窗口">
                        <Path Data="M 1,1 L 13,13 M 13,1 L 1,13"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </Grid>
            </Border>

            <StackPanel x:Name="Dashboard" Margin="13,12,13,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <Grid Margin="11,9,11,9">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <Ellipse Width="6" Height="6" Margin="0,0,5,0" Fill="{StaticResource CpuBrush}"/>
                                <TextBlock Text="CPU 温度" Style="{StaticResource MetricLabel}"/>
                            </DockPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock x:Name="CpuValue" Text="—" Style="{StaticResource MetricValue}"
                                           Foreground="{StaticResource CpuBrush}" FontSize="33"
                                           AutomationProperties.Name="CPU 温度"/>
                                <TextBlock Text="°C" Margin="5,0,0,5" VerticalAlignment="Bottom"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="2" x:Name="CpuVendor" Text="—" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <Grid Margin="11,9,11,9">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <Ellipse Width="6" Height="6" Margin="0,0,5,0" Fill="{StaticResource GpuBrush}"/>
                                <TextBlock Text="GPU 温度" Style="{StaticResource MetricLabel}"/>
                            </DockPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock x:Name="GpuValue" Text="—" Style="{StaticResource MetricValue}"
                                           Foreground="{StaticResource GpuBrush}" FontSize="33"
                                           AutomationProperties.Name="GPU 温度"/>
                                <TextBlock Text="°C" Margin="5,0,0,5" VerticalAlignment="Bottom"
                                           Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="2" x:Name="GpuVendor" Text="—" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </Grid>
                    </Border>
                </Grid>

                <Border x:Name="AlertBanner" CornerRadius="7" Padding="9,7" Margin="0,8,0,0"
                        BorderBrush="#765425" BorderThickness="1" Background="#251D15"
                        Visibility="Collapsed">
                    <TextBlock x:Name="AlertText" Foreground="{StaticResource AlertBrush}"
                               TextWrapping="Wrap" FontSize="11"
                               AutomationProperties.LiveSetting="Polite"/>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                    <StackPanel Margin="10,9,10,7">
                        <DockPanel Margin="0,0,0,2">
                            <ComboBox x:Name="ChartRange" DockPanel.Dock="Right" Width="85" FontSize="11"
                                      SelectedIndex="0" SelectionChanged="ChangeChartRange"
                                      AutomationProperties.Name="温度曲线时间范围">
                                <ComboBoxItem Content="近 1 分钟" Tag="1"/>
                                <ComboBoxItem Content="近 5 分钟" Tag="5"/>
                                <ComboBoxItem Content="近 15 分钟" Tag="15"/>
                            </ComboBox>
                            <TextBlock Text="温度曲线" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <local:TemperatureChart x:Name="HistoryChart" Height="119"
                                                AutomationProperties.Name="CPU 和 GPU 温度历史曲线"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                    <StackPanel Margin="11,9,11,8">
                        <DockPanel>
                            <TextBlock Text="RPM" DockPanel.Dock="Right" FontSize="10"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="风扇转速" FontWeight="SemiBold"/>
                        </DockPanel>
                        <TextBlock x:Name="FanEmpty" Text="正在读取…" Margin="0,5,0,0"
                                   Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="78">
                            <ItemsControl x:Name="FanList" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel MinHeight="20">
                                            <TextBlock Text="{Binding Value}" DockPanel.Dock="Right"
                                                       Foreground="{Binding Brush}" FontFamily="Consolas"
                                                       FontWeight="SemiBold" FontSize="14" Margin="8,0,0,0"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource MutedBrush}"
                                                       FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <DockPanel Margin="1,8,1,0">
                    <TextBlock x:Name="UpdateTime" DockPanel.Dock="Right"
                               Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                    <TextBlock x:Name="SensorStatus" Text="正在读取传感器…" FontSize="10"
                               Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </StackPanel>

            <StackPanel x:Name="SettingsPanel" Margin="13,12,13,12" Visibility="Collapsed">
                <TextBlock Text="监控设置" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock Text="留空可关闭对应告警。设置保存在本机。" Margin="0,3,0,10"
                           FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                <Border Style="{StaticResource Card}">
                    <Grid Margin="11">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="36"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="CPU 高温 (°C)" VerticalAlignment="Center"/>
                        <TextBox x:Name="CpuLimit" Grid.Column="1" MaxLength="3"
                                 VerticalAlignment="Center" AutomationProperties.Name="CPU 高温阈值"/>
                        <TextBlock Grid.Row="1" Text="GPU 高温 (°C)" VerticalAlignment="Center"/>
                        <TextBox x:Name="GpuLimit" Grid.Row="1" Grid.Column="1" MaxLength="3"
                                 VerticalAlignment="Center" AutomationProperties.Name="GPU 高温阈值"/>
                        <TextBlock Grid.Row="2" Text="风扇低转速 (RPM)" VerticalAlignment="Center"/>
                        <TextBox x:Name="FanLimit" Grid.Row="2" Grid.Column="1" MaxLength="5"
                                 VerticalAlignment="Center" AutomationProperties.Name="风扇低转速阈值"/>
                        <TextBlock Grid.Row="3" Text="采样间隔" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SampleRate" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center"
                                  AutomationProperties.Name="采样间隔">
                            <ComboBoxItem Content="2 秒" Tag="2"/>
                            <ComboBoxItem Content="5 秒" Tag="5"/>
                            <ComboBoxItem Content="10 秒" Tag="10"/>
                        </ComboBox>
                    </Grid>
                </Border>
                <TextBlock Text="风扇在低负载下可能停转。低转速告警默认关闭。"
                           Margin="0,8,0,7" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                <CheckBox x:Name="AlertSound" Content="触发新告警时播放系统提示音"/>
                <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="10,9">
                    <StackPanel>
                        <CheckBox x:Name="KeepOnTop" Content="始终置顶"/>
                        <CheckBox x:Name="LaunchOnLogin" Content="登录 Windows 后自动启动" Margin="0,7,0,0"
                                  ToolTip="Windows 的「启动应用」设置可以停用此项。"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="SettingsError" Visibility="Collapsed" TextWrapping="Wrap"
                           Margin="0,8,0,0" Foreground="{StaticResource AlertBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="返回" Style="{StaticResource QuietButton}" MinWidth="64"
                            Margin="0,0,6,0" Click="ToggleSettings" IsCancel="True"/>
                    <Button Content="保存" Style="{StaticResource PrimaryButton}" MinWidth="64"
                            Click="SaveSettings" IsDefault="True"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
